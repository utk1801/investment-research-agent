# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local                    # local | production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invest_agent
POSTGRES_USER=invest_agent
POSTGRES_PASSWORD=invest123

# ── ChromaDB ────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_SERVER_ROOT_URL=http://localhost:3000

# ── Ingestion ────────────────────────────────────────────────────────────────
INGEST_SCHEDULE_DAILY="0 6 * * *"   # cron: run daily at 6am
INGEST_SCHEDULE_WEEKLY="0 7 * * 1"  # cron: run weekly Monday 7am

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o                  # gpt-4o | gpt-4o-mini | gpt-3.5-turbo
LLM_TEMPERATURE=0.3
EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers model name
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_RETRIEVAL_APPROACH=hybrid  # bm25 | vector | hybrid | hybrid_rerank
ENABLE_QUERY_REWRITING=true

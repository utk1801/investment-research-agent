          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH variants AS (\n  SELECT 'A' AS code, 'Variant A' AS metric\n  UNION ALL SELECT 'B', 'Variant B'\n  UNION ALL SELECT 'C', 'Variant C'\n)\nSELECT\n  v.metric,\n  COUNT(q.id)::float AS value\nFROM variants v\nLEFT JOIN query_log q\n  ON q.prompt_variant = v.code\n AND $__timeFilter(q.created_at)\nGROUP BY v.code, v.metric\nORDER BY v.code",
          "refId": "A",
          "timeColumn": "none",
          "timeGroupInterval": "auto",
          "where": []
        }
      ],
